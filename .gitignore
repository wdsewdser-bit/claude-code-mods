# Written by the engine when it loads a mod: every mod gets its own .claude-plugin/types/.
**/.claude-plugin/types/
node_modules/
*.bak-*
# Local tooling.
/sync-from-local.ps1
# Local notes and dev records (kept out of the repo).
/BACKLOG.md
/ctx-mod/SPEC-*.md
/ctx-mod/NOTES-dev.md
/ctx-mod/REVIEW-*.md
# Dev leftovers inside each mod.
*.pre-*
*.bak
*.bak-*
*.dedup-v1
dryrun.log
/ptc-run/bin/
phase0/
